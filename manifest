# GenePattern Module Manifest

LSID=urn:lsid:broad.mit.edu:cancer.software.genepattern.module.generated:00000:1
name=gatk.SelectVariants
version=1
author=GenePattern Team, Broad Institute
description=Selects a subset of variants from a VCF file based on criteria such as variant type (SNP, INDEL), sample identity, JEXL filter expressions, and filtering status. Produces a new VCF containing only the variants that meet the selection criteria. Part of the GATK4 variant filtering toolkit.
categories=Variant Analysis
commandLine=bash <libdir>gatk_selectvariants_wrapper.sh <input.vcf> <input.vcf.tbi> <reference> <reference.fai> <reference.dict> --output.vcf.name <output.vcf.name> <select.type.to.include> <select.expressions> <exclude.filtered> <exclude.non.variants> <remove.unused.alternates> <keep.original.chr.counts> <sample.name> <arguments.file> <gatk.config.file>
cpuType=any
os=any
language=Java
taskType=Java
taskDoc=README.md
quality=development
privacy=public
job.cpuCount=2
job.memory=8Gb
job.docker.image=broadinstitute/gatk\:4.1.4.1
src.repo=https://github.com/broadinstitute/gatk
documentationUrl=https://github.com/genepattern/gatk.SelectVariants
fileFormat=vcf;vcf.gz


# Parameters

p1_MODE=IN
p1_TYPE=FILE
p1_description=Input VCF file containing variants to be subsetted. Accepts uncompressed (.vcf) or bgzip-compressed (.vcf.gz) format. If .vcf.gz is provided, also supply the companion tabix index via the input.vcf.tbi parameter. Passed to GATK as -V / --variant.
p1_fileFormat=vcf;vcf.gz;gz
p1_name=input.vcf
p1_numValues=1..1
p1_optional=
p1_prefix_when_specified=--input.vcf 
p1_type=java.io.File

p2_MODE=IN
p2_TYPE=FILE
p2_description=Tabix index (.tbi) for the input VCF when it is bgzip-compressed (.vcf.gz). Must have exactly the same base name as the input VCF with .tbi appended (e.g. variants.vcf.gz.tbi). If the input VCF is uncompressed, leave this parameter blank. The index is staged in the same directory as the VCF so GATK can locate it automatically.
p2_fileFormat=tbi
p2_name=input.vcf.tbi
p2_numValues=0..1
p2_optional=on
p2_prefix_when_specified=--input.vcf.tbi 
p2_type=java.io.File

p3_MODE=IN
p3_TYPE=FILE
p3_description=Reference genome FASTA file. Must be the same reference used for alignment and variant calling. Also supply the companion FASTA index (reference.fai) and sequence dictionary (reference.dict). Passed to GATK as -R / --reference.
p3_fileFormat=fasta;fa;fna
p3_name=reference
p3_numValues=1..1
p3_optional=
p3_prefix_when_specified=--reference 
p3_type=java.io.File

p4_MODE=IN
p4_TYPE=FILE
p4_description=FASTA index file (.fai) corresponding to the reference FASTA. Generated by samtools faidx. Must be staged in the same directory as the reference FASTA with the filename <reference>.fai. This file is not passed directly to GATK but must be co-located with the reference.
p4_fileFormat=fai
p4_name=reference.fai
p4_numValues=1..1
p4_optional=
p4_prefix_when_specified=--reference.fai 
p4_type=java.io.File

p5_MODE=IN
p5_TYPE=FILE
p5_description=Sequence dictionary (.dict) corresponding to the reference FASTA. Generated by picard CreateSequenceDictionary or GATK CreateSequenceDictionary. Must be staged alongside the reference with the filename <reference-basename>.dict. This file is not passed directly to GATK but must be co-located with the reference.
p5_fileFormat=dict
p5_name=reference.dict
p5_numValues=1..1
p5_optional=
p5_prefix_when_specified=--reference.dict 
p5_type=java.io.File

p6_TYPE=TEXT
p6_default_value=selected.vcf
p6_description=Name for the output VCF file containing the selected variants. Use a .vcf or .vcf.gz extension. GATK will recalculate AN, AC, and AF annotations for the selected subset. Passed to GATK as -O / --output.
p6_name=output.vcf.name
p6_numValues=1..1
p6_optional=
p6_type=java.lang.String

p7_TYPE=TEXT
p7_description=Select only variants of a specific type. Valid values: SNP, INDEL, MIXED, MNP, SYMBOLIC, NO_VARIATION. To filter by multiple types, use the arguments.file parameter with multiple --select-type-to-include entries. Passed to GATK as --select-type-to-include.
p7_name=select.type.to.include
p7_numValues=0..1
p7_optional=on
p7_prefix_when_specified=--select.type.to.include 
p7_type=java.lang.String
p7_value=SNP\=SNP;INDEL\=INDEL;MIXED\=MIXED;MNP\=MNP;SYMBOLIC\=SYMBOLIC;NO_VARIATION\=NO_VARIATION

p8_TYPE=TEXT
p8_description=A JEXL (Java Expression Language) expression used to filter variants. Variants for which the expression evaluates to true are included in the output. May reference INFO field annotations (e.g., AF > 0.001, DP > 100) or VariantContext methods. Passed to GATK as -select.
p8_name=select.expressions
p8_numValues=0..1
p8_optional=on
p8_prefix_when_specified=--select.expressions 
p8_type=java.lang.String

p9_TYPE=TEXT
p9_description=When set to true, variants that have been marked as filtered (any value other than PASS in the FILTER field) are not included in the output. Passed to GATK as --exclude-filtered.
p9_name=exclude.filtered
p9_numValues=0..1
p9_optional=on
p9_prefix_when_specified=--exclude.filtered 
p9_type=java.lang.String
p9_value=Yes\=true;No\=false

p10_TYPE=TEXT
p10_description=When set to true, sites where no sample carries an alternate allele (reference-only sites) are excluded from the output. Passed to GATK as --exclude-non-variants.
p10_name=exclude.non.variants
p10_numValues=0..1
p10_optional=on
p10_prefix_when_specified=--exclude.non.variants 
p10_type=java.lang.String
p10_value=Yes\=true;No\=false

p11_TYPE=TEXT
p11_description=When set to true, alternate alleles that are not present in any of the output samples are removed from the ALT field. Useful when subsetting samples to clean up unused alleles. Passed to GATK as --remove-unused-alternates.
p11_name=remove.unused.alternates
p11_numValues=0..1
p11_optional=on
p11_prefix_when_specified=--remove.unused.alternates 
p11_type=java.lang.String
p11_value=Yes\=true;No\=false

p12_TYPE=TEXT
p12_description=When set to true, the original AC, AF, and AN annotation values are preserved in new INFO fields (AC_Orig, AF_Orig, AN_Orig) before recalculation for the output subset. Useful for auditing how allele frequency changed. Passed to GATK as --keep-original-chr-counts.
p12_name=keep.original.chr.counts
p12_numValues=0..1
p12_optional=on
p12_prefix_when_specified=--keep.original.chr.counts 
p12_type=java.lang.String
p12_value=Yes\=true;No\=false

p13_TYPE=TEXT
p13_description=Include only genotypes from this sample name in the output VCF. The output VCF will contain only this sample's column; AN, AC, and AF annotations are recalculated accordingly. To include multiple samples or exclude samples, use the arguments.file parameter. Passed to GATK as --sample-name / -sn.
p13_name=sample.name
p13_numValues=0..1
p13_optional=on
p13_prefix_when_specified=--sample.name 
p13_type=java.lang.String

p14_MODE=IN
p14_TYPE=FILE
p14_description=Optional GATK arguments file containing additional parameters to pass to SelectVariants (one argument or argument=value per line). Use this to specify advanced GATK options not exposed as module parameters (e.g., --java-options, --tmp-dir, multiple --sample-name or --select-type-to-include entries). Passed to GATK as --arguments_file.
p14_fileFormat=txt
p14_name=arguments.file
p14_numValues=0..1
p14_optional=on
p14_prefix_when_specified=--arguments.file 
p14_type=java.io.File

p15_MODE=IN
p15_TYPE=FILE
p15_description=Optional GATK configuration file (properties format) to customize GATK behavior including logging, performance settings, and default tool arguments. Passed to GATK as --gatk-config-file.
p15_fileFormat=properties;conf;config;txt
p15_name=gatk.config.file
p15_numValues=0..1
p15_optional=on
p15_prefix_when_specified=--gatk.config.file 
p15_type=java.io.File

